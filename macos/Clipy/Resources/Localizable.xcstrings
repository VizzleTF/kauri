    "syncCodeMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These 24 words open your synced data. Write them down and keep them safe: anyone who has them can read your snippets. You need them if you lose all your devices."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти 24 слова открывают синхронизированные данные. Запишите их и храните надёжно: у кого они есть, тот может прочитать сниппеты. Они понадобятся, если вы потеряете все устройства."
          }
        }
      }
    },
